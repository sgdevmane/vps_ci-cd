# Production Environment Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PROD_PORT=19443
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
# DATABASE_URL=postgres://vps_prod_user:password@db.example.com:5432/vps_cicd_prod?sslmode=require
PG_SSL=false
DATA_DIR=/app/data
DATABASE_FILE=/app/data/app.db
SESSION_DAYS=7
COOKIE_SECURE=false
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123
METRICS_ENABLED=true
SWAGGER_ENABLED=true
