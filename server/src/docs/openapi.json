{
  "openapi": "3.0.3",
  "info": {
    "title": "VPS CI/CD Automation Runner API",
    "description": "Webhook-driven git sync, automated zero-downtime deployment runner, and telemetry platform for self-hosted VPS instances.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication and user sessions" },
    { "name": "Services", "description": "Repository and directory sync services" },
    { "name": "Triggers", "description": "Deployment runs, SSE log streaming, and webhook audits" },
    { "name": "Notifications", "description": "Slack, Discord, Telegram & Webhook alerts" },
    { "name": "Badges", "description": "Shields.io dynamic SVG and JSON status badges" },
    { "name": "System", "description": "VPS system health and disaster recovery backups" },
    { "name": "Settings", "description": "System configuration" },
    { "name": "Webhooks", "description": "Inbound git webhooks" }
  ],
  "paths": {
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get authenticated user information",
        "responses": {
          "200": { "description": "Current user status" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate administrator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Sign in successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Terminate session",
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/api/services": {
      "get": {
        "tags": ["Services"],
        "summary": "List all configured sync services",
        "responses": {
          "200": { "description": "List of services" }
        }
      },
      "post": {
        "tags": ["Services"],
        "summary": "Create a new sync service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ServiceInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Service created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/services/{id}": {
      "get": {
        "tags": ["Services"],
        "summary": "Get service details by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Service details" },
          "404": { "description": "Service not found" }
        }
      },
      "put": {
        "tags": ["Services"],
        "summary": "Update service configuration",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ServiceInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Service updated" }
        }
      },
      "delete": {
        "tags": ["Services"],
        "summary": "Delete service",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Service deleted" }
        }
      }
    },
    "/api/services/{id}/sync": {
      "post": {
        "tags": ["Services"],
        "summary": "Manually trigger immediate git sync and deployment",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "branch": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Sync queued" }
        }
      }
    },
    "/api/services/{id}/rollback": {
      "post": {
        "tags": ["Services"],
        "summary": "Rollback service to a target commit SHA",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["targetSha"],
                "properties": {
                  "targetSha": { "type": "string" },
                  "branch": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Rollback queued" }
        }
      }
    },
    "/api/services/{id}/commits": {
      "get": {
        "tags": ["Services"],
        "summary": "Get git commit history for service repository",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Commit log" }
        }
      }
    },
    "/api/services/{id}/env": {
      "get": {
        "tags": ["Services"],
        "summary": "Get encrypted environment variables keys for service",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Environment variables" }
        }
      },
      "put": {
        "tags": ["Services"],
        "summary": "Save encrypted environment variables for service",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Environment variables updated" }
        }
      }
    },
    "/api/triggers": {
      "get": {
        "tags": ["Triggers"],
        "summary": "List execution triggers and audit history",
        "parameters": [
          { "name": "service_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of triggers" }
        }
      }
    },
    "/api/triggers/{id}": {
      "get": {
        "tags": ["Triggers"],
        "summary": "Get trigger details and full execution logs",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Trigger details" }
        }
      }
    },
    "/api/triggers/{id}/stream": {
      "get": {
        "tags": ["Triggers"],
        "summary": "Live Server-Sent Events (SSE) log chunk stream for trigger",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "SSE Event stream (text/event-stream)" }
        }
      }
    },
    "/api/notifications/channels": {
      "get": {
        "tags": ["Notifications"],
        "summary": "List configured notification channels",
        "responses": {
          "200": { "description": "List of channels" }
        }
      },
      "post": {
        "tags": ["Notifications"],
        "summary": "Create notification channel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "provider"],
                "properties": {
                  "name": { "type": "string" },
                  "provider": { "type": "string", "enum": ["slack", "discord", "telegram", "webhook"] },
                  "webhook_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Channel created" }
        }
      }
    },
    "/api/notifications/channels/{id}/test": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Dispatch test alert to notification channel",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Test sent" }
        }
      }
    },
    "/api/badges/{serviceId}/status.svg": {
      "get": {
        "tags": ["Badges"],
        "summary": "Get dynamic Shields.io compatible SVG status badge",
        "parameters": [{ "name": "serviceId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "SVG image (image/svg+xml)" }
        }
      }
    },
    "/api/system/health": {
      "get": {
        "tags": ["System"],
        "summary": "Get live VPS system telemetry (CPU, RAM, Disk, Uptime)",
        "responses": {
          "200": { "description": "System health metrics" }
        }
      }
    },
    "/api/system/backup/export": {
      "get": {
        "tags": ["System"],
        "summary": "Download disaster recovery JSON configuration backup",
        "responses": {
          "200": { "description": "JSON backup file" }
        }
      }
    },
    "/api/system/backup/import": {
      "post": {
        "tags": ["System"],
        "summary": "Restore server configurations from JSON backup",
        "responses": {
          "200": { "description": "Restored successfully" }
        }
      }
    },
    "/api/hooks/{hookToken}": {
      "post": {
        "tags": ["Webhooks"],
        "summary": "Public inbound git webhook receiver",
        "parameters": [{ "name": "hookToken", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Ping or skipped processed" },
          "202": { "description": "Trigger enqueued" },
          "401": { "description": "Signature verification failed" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceInput": {
        "type": "object",
        "required": ["name", "repo_url", "folder_path"],
        "properties": {
          "name": { "type": "string" },
          "provider": { "type": "string", "enum": ["github", "gitlab", "bitbucket", "gitea", "gogs", "generic"] },
          "repo_url": { "type": "string" },
          "folder_path": { "type": "string" },
          "branch_mode": { "type": "string", "enum": ["webhook", "fixed", "current"] },
          "fixed_branch": { "type": "string" },
          "allowed_branches": { "type": "string" },
          "sync_mode": { "type": "string", "enum": ["pull", "reset"] },
          "healthcheck_url": { "type": "string" },
          "auto_rollback": { "type": "boolean" },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "branch_filter": { "type": "string" },
                "continue_on_error": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
