{
  "openapi": "3.0.3",
  "info": {
    "title": "VPS CI/CD Automation Runner API",
    "description": "Webhook-driven git sync, automated zero-downtime deployment runner, and telemetry platform for self-hosted VPS instances.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and user sessions"
    },
    {
      "name": "Services",
      "description": "Repository and directory sync services"
    },
    {
      "name": "Triggers",
      "description": "Deployment runs, SSE log streaming, and webhook audits"
    },
    {
      "name": "Notifications",
      "description": "Slack, Discord, Telegram & Webhook alerts"
    },
    {
      "name": "Badges",
      "description": "Shields.io dynamic SVG and JSON status badges"
    },
    {
      "name": "System",
      "description": "VPS system health and disaster recovery backups"
    },
    {
      "name": "Settings",
      "description": "System configuration"
    },
    {
      "name": "Webhooks",
      "description": "Inbound git webhooks"
    }
  ],
  "paths": {
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get authenticated user information",
        "responses": {
          "200": {
            "description": "Current user status"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate administrator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign in successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Terminate session",
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "List all configured sync services",
        "responses": {
          "200": {
            "description": "List of services"
          }
        }
      },
      "post": {
        "tags": [
          "Services"
        ],
        "summary": "Create a new sync service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/services/{id}": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Get service details by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service details"
          },
          "404": {
            "description": "Service not found"
          }
        }
      },
      "put": {
        "tags": [
          "Services"
        ],
        "summary": "Update service configuration",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Services"
        ],
        "summary": "Delete service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service deleted"
          }
        }
      }
    },
    "/api/services/{id}/sync": {
      "post": {
        "tags": [
          "Services"
        ],
        "summary": "Manually trigger immediate git sync and deployment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sync queued"
          }
        }
      }
    },
    "/api/services/{id}/rollback": {
      "post": {
        "tags": [
          "Services"
        ],
        "summary": "Rollback service to a target commit SHA",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "targetSha"
                ],
                "properties": {
                  "targetSha": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Rollback queued"
          }
        }
      }
    },
    "/api/services/{id}/commits": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Get git commit history for service repository",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit log"
          }
        }
      }
    },
    "/api/services/{id}/env": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Get encrypted environment variables keys for service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Environment variables"
          }
        }
      },
      "put": {
        "tags": [
          "Services"
        ],
        "summary": "Save encrypted environment variables for service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Environment variables updated"
          }
        }
      }
    },
    "/api/triggers": {
      "get": {
        "tags": [
          "Triggers"
        ],
        "summary": "List recent triggers across all services",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 40
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "service_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trigger list"
          }
        }
      }
    },
    "/api/triggers/{id}": {
      "get": {
        "tags": [
          "Triggers"
        ],
        "summary": "Get trigger details and full execution logs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trigger details"
          }
        }
      }
    },
    "/api/triggers/{id}/stream": {
      "get": {
        "tags": [
          "Triggers"
        ],
        "summary": "Live Server-Sent Events (SSE) log chunk stream for trigger",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE Event stream (text/event-stream)"
          }
        }
      }
    },
    "/api/notifications/channels": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List configured notification channels",
        "responses": {
          "200": {
            "description": "List of channels"
          }
        }
      },
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Create notification channel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "provider"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "slack",
                      "discord",
                      "telegram",
                      "webhook"
                    ]
                  },
                  "webhook_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Channel created"
          }
        }
      }
    },
    "/api/notifications/channels/{id}/test": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Dispatch test alert to notification channel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test sent"
          }
        }
      }
    },
    "/api/badges/{serviceId}/status.svg": {
      "get": {
        "tags": [
          "Badges"
        ],
        "summary": "Get dynamic Shields.io compatible SVG status badge",
        "parameters": [
          {
            "name": "serviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SVG image (image/svg+xml)"
          }
        }
      }
    },
    "/api/system/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get live VPS system telemetry (CPU, RAM, Disk, Uptime)",
        "responses": {
          "200": {
            "description": "System health metrics"
          }
        }
      }
    },
    "/api/system/backup/export": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Download disaster recovery JSON configuration backup",
        "responses": {
          "200": {
            "description": "JSON backup file"
          }
        }
      }
    },
    "/api/system/backup/import": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Restore server configurations from JSON backup",
        "responses": {
          "200": {
            "description": "Restored successfully"
          }
        }
      }
    },
    "/api/hooks/{hookToken}": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Public inbound git webhook receiver",
        "parameters": [
          {
            "name": "hookToken",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ping or skipped processed"
          },
          "202": {
            "description": "Trigger enqueued"
          },
          "401": {
            "description": "Signature verification failed"
          }
        }
      }
    },
    "/api/services/{id}/notifications": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "List notification bindings for a service",
        "responses": {
          "200": {
            "description": "Bindings list"
          }
        }
      },
      "put": {
        "tags": [
          "Services"
        ],
        "summary": "Replace notification bindings for a service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bindings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "channel_id": {
                          "type": "integer"
                        },
                        "on_start": {
                          "type": "boolean"
                        },
                        "on_success": {
                          "type": "boolean"
                        },
                        "on_failure": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bindings saved"
          }
        }
      }
    },
    "/api/auth/security-question": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the configured security question",
        "responses": {
          "200": {
            "description": "Question state"
          }
        }
      },
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Set or update the security question and answer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "answer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset the password by answering the security question",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "answer",
                  "newPassword"
                ],
                "properties": {
                  "answer": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset & signed in"
          },
          "401": {
            "description": "Incorrect answer"
          },
          "404": {
            "description": "No security question set"
          }
        }
      }
    },
    "/api/notifications/channels/{id}": {
      "put": {
        "tags": [
          "Notifications"
        ],
        "summary": "Update a notification channel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "webhook_url": {
                    "type": "string"
                  },
                  "config": {
                    "type": "object"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Channel updated"
          },
          "404": {
            "description": "Channel not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Notifications"
        ],
        "summary": "Delete a notification channel",
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Channel not found"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get server settings",
        "responses": {
          "200": {
            "description": "Settings"
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Update the public base URL setting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicBaseUrl": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/api/system/audit": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Security audit trail (latest first)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit log entries"
          }
        }
      }
    },
    "/api/badges/{serviceId}/status.json": {
      "get": {
        "tags": [
          "Badges"
        ],
        "summary": "Shields.io endpoint JSON status badge",
        "responses": {
          "200": {
            "description": "JSON badge"
          },
          "404": {
            "description": "Service not found"
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Prometheus metrics exposition",
        "responses": {
          "200": {
            "description": "text/plain metrics"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness & readiness probe",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/api/services/{id}/triggers": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "List triggers for a service",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 30
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trigger list"
          },
          "404": {
            "description": "Service not found"
          }
        }
      }
    },
    "/api/triggers/stream/global": {
      "get": {
        "tags": [
          "Triggers"
        ],
        "summary": "Global SSE stream of trigger status transitions",
        "responses": {
          "200": {
            "description": "text/event-stream"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change the administrator password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Current password incorrect"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceInput": {
        "type": "object",
        "required": [
          "name",
          "repo_url",
          "folder_path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "gitea",
              "gogs",
              "generic"
            ]
          },
          "repo_url": {
            "type": "string"
          },
          "folder_path": {
            "type": "string"
          },
          "branch_mode": {
            "type": "string",
            "enum": [
              "webhook",
              "fixed",
              "current"
            ]
          },
          "fixed_branch": {
            "type": "string"
          },
          "allowed_branches": {
            "type": "string"
          },
          "sync_mode": {
            "type": "string",
            "enum": [
              "pull",
              "reset"
            ]
          },
          "healthcheck_url": {
            "type": "string"
          },
          "auto_rollback": {
            "type": "boolean"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "branch_filter": {
                  "type": "string"
                },
                "continue_on_error": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
