# =============================================================================
# VPS CI/CD — Environment Configuration Example
# =============================================================================

# --- Server & HTTP -----------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Docker Nginx exposed host port (avoids common 3000, 8000, 8080 ports)
PROD_PORT=19443
STAGING_PORT=19444
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# --- Database ----------------------------------------------------------------
# Remote PostgreSQL Database URL (Leave commented to use local SQLite)
# DATABASE_URL=postgres://vps_user:SecretPassword123@db.example.com:5432/vps_cicd_prod?sslmode=require
PG_SSL=false

# Local SQLite fallback storage
DATA_DIR=/app/data
DATABASE_FILE=/app/data/app.db

# --- Security & Sessions -----------------------------------------------------
SESSION_DAYS=7
COOKIE_SECURE=false

# --- First-Boot Default Administrator ----------------------------------------
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# --- Observability & Documentation ------------------------------------------
METRICS_ENABLED=true
SWAGGER_ENABLED=true
