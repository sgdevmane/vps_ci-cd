# --- HTTP server ---------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Storage ---------------------------------------------------------------
# SQLite database lives here (created on first boot).
# DATA_DIR=/opt/vps-ci-cd/data
# DATABASE_FILE=/opt/vps-ci-cd/data/app.db

# --- Sessions ---------------------------------------------------------------
# Session cookie lifetime in days.
SESSION_DAYS=7
# Set to true when the panel is served over HTTPS (behind a TLS proxy).
COOKIE_SECURE=false

# --- First-boot admin credentials --------------------------------------------
# Only used while the users table is empty. Change the password after login.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123
