{
  "info": {
    "name": "VPS CI/CD Automation Runner API",
    "description": "Comprehensive Postman Collection for VPS CI/CD with Auth, Services, Rollbacks, Env Vars, Notifications, Webhooks, and Telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:19443", "type": "string" },
    { "key": "serviceId", "value": "1", "type": "string" },
    { "key": "triggerId", "value": "1", "type": "string" },
    { "key": "hookToken", "value": "03fe4862b5d4e12e", "type": "string" },
    { "key": "channelId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign In (Login)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Sign Out (Logout)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "List Services",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/services"
          }
        },
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/services",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Frontend App\",\n  \"provider\": \"github\",\n  \"repo_url\": \"https://github.com/org/frontend.git\",\n  \"folder_path\": \"/var/www/frontend\",\n  \"branch_mode\": \"webhook\",\n  \"sync_mode\": \"pull\",\n  \"secret\": \"whsec_topsecret123\",\n  \"commands\": [\n    {\n      \"command\": \"npm ci && npm run build\",\n      \"continue_on_error\": false\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Service by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/services/{{serviceId}}"
          }
        },
        {
          "name": "Manual Sync / Deploy",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/services/{{serviceId}}/sync",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"branch\": \"main\"\n}" }
          }
        },
        {
          "name": "Rollback Service to Commit",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/services/{{serviceId}}/rollback",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetSha\": \"a1b2c3d4e5f67890\"\n}" }
          }
        },
        {
          "name": "Get Commit History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/services/{{serviceId}}/commits"
          }
        },
        {
          "name": "Get Service Env Vars",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/services/{{serviceId}}/env"
          }
        },
        {
          "name": "Save Service Env Vars",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/services/{{serviceId}}/env",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"env\": [\n    { \"key\": \"PORT\", \"value\": \"3000\" },\n    { \"key\": \"API_KEY\", \"value\": \"secret_value_123\" }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Channels",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications/channels" }
        },
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/channels",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Slack DevOps\",\n  \"provider\": \"slack\",\n  \"webhook_url\": \"https://hooks.slack.com/services/T00/B00/X00\"\n}"
            }
          }
        },
        {
          "name": "Test Channel Alert",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/notifications/channels/{{channelId}}/test" }
        }
      ]
    },
    {
      "name": "System & Telemetry",
      "item": [
        {
          "name": "System Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/system/health" }
        },
        {
          "name": "Prometheus Metrics",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/metrics" }
        },
        {
          "name": "Export Backup JSON",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/system/backup/export" }
        },
        {
          "name": "Status Badge SVG",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/badges/{{serviceId}}/status.svg" }
        }
      ]
    }
  ]
}
